            },
            "access" : "readonly",
            "description" :
                """The bank associated with this outlet.""",
        }, # column
        "rPDUOutletStatusLoad" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.12.3.5.1.1.7",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"RFC1155-SMI", "name" : "Gauge"},
            },
            "access" : "readonly",
            "description" :
                """Getting this OID will return the measured Outlet load for
an Outlet Monitored Rack PDU in tenths of Amps. For other
models this OID is not supported.""",
        }, # column
        "rPDUOutletBank" : {
            "nodetype" : "node",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.12.3.6",
        }, # node
        "rPDUOutletBankTable" : {
            "nodetype" : "table",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.12.3.6.1",
            "status" : "current",
            "description" :
                """Allows for management of outlets on a per bank basis.""",
        }, # table
        "rPDUOutletBankEntry" : {
            "nodetype" : "row",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.12.3.6.1.1",
            "status" : "current",
            "linkage" : [
                "rPDUOutletBankIndex",
            ],
            "description" :
                """The bank to manage.""",
        }, # row
        "rPDUOutletBankIndex" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.12.3.6.1.1.1",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readonly",
            "description" :
                """The index to the Switched Rack PDU bank entry.""",
        }, # column
        "rPDUOutletBankOverloadRestriction" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.12.3.6.1.1.2",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "alwaysAllowTurnON" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "restrictOnNearOverload" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                    "restrictOnOverload" : {
                        "nodetype" : "namednumber",
                        "number" : "3"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """This OID controls the behavior of a Switched Rack PDU
bank when an overload condition is possible and
additional outlets are requested to be turned on.

Setting this OID to alwaysAllowTurnON (1) will always allow
the outlets on the corresponding bank to turn on.

Setting this OID to restrictOnNearOverload (2) will not allow
outlets on the corresponding bank to turn on if the
rPDULoadBankConfigNearOverloadThreshold OID is exceeded.

Setting this OID to restrictOnOverload (3) will not allow
outlets on the corresponding bank to turn on if the
rPDULoadBankConfigOverloadThreshold OID is exceeded.""",
        }, # column
        "rPDUPowerSupply" : {
            "nodetype" : "node",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.12.4",
        }, # node
        "rPDUPowerSupplyDevice" : {
            "nodetype" : "node",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.12.4.1",
        }, # node
        "rPDUPowerSupply1Status" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.12.4.1.1",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "powerSupplyOneOk" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "powerSupplyOneFailed" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                },
            },
            "access" : "readonly",
            "description" :
                """Getting this OID will return powerSupply1Ok(1) if power
supply 1 is functioning normally.  If not functioning normally,
this OID will return powerSupply1Failed(2).""",
        }, # scalar
        "rPDUPowerSupply2Status" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.12.4.1.2",
