            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.17.5.3.1",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "never" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "daily" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                    "weekly" : {
