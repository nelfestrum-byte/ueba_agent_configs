                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readwrite",
            "description" :
                """The amount of time, in seconds, this outlet will
delay powering off.
Range -1...7200 where -1 = Never power off,
0 = immediate power off, and 1-7200 = seconds to
delay.""",
        }, # column
