                    },
                    "dropLoad" : {
                        "nodetype" : "namednumber",
                        "number" : "3"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """Configure the UPS fail action.  If UPS fails,
and frequency or voltage is out of range it will either
