            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "nplus0" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "nplus1" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                    "nplus2" : {
                        "nodetype" : "namednumber",
                        "number" : "3"
                    },
                    "nplus3" : {
