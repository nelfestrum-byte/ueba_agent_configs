                    "basetype" : "Enumeration",
                    "no" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "yes" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
