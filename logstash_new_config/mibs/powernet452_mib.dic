                "type" : { "module" :"RFC1213-MIB", "name" : "DisplayString"},
            },
            "access" : "readwrite",
            "description" :
                """The name of the Monitored Outlet. The maximum string size is device dependent.
An error will be returned if the set request exceeds the max size.""",
        }, # column
        "rPDUOutletConfigMonitoredNumber" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.12.3.4.3.1.3",
