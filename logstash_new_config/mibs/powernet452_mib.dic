can only be changed directly from the front panel.""",
        }, # scalar
        "dm3StatusSysTempSanity" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.7.3.1.5",
