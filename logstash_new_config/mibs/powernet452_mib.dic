                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                    "reset" : {
                        "nodetype" : "namednumber",
                        "number" : "3"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """Setting this OID to reset(2) will allows the system
