                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "reset" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """This control resets the event counts when the value is set to reset(2).""",
        }, # column
