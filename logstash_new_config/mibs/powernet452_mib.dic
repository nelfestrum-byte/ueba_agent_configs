        }, # column
        "rARUStatusAruManualSetpoint" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.14.3.3.1.4",
            "status" : "current",
            "syntax" : {
                "type" :                 {
