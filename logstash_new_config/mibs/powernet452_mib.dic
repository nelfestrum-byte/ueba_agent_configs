                        "number" : "2"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """The value of yes(1) indicates that trap generation for this manager is enabled.
The value of no(2) indicates that trap generation for this manager is disabled""",
        }, # column
        "receiveTrapType" : {
            "nodetype" : "column",
