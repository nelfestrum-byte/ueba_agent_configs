        "atsControlResetATS" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.8.3.1",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "none" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "reset" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """Setting this variable will cause the Automatic Transfer Switch to
perform a power-on reset. It is not applicable to AP44xx or newer.""",
        }, # scalar
        "atsControlClearAllAlarms" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.8.3.2",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "none" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "clear" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """Setting this variable will clear all alarms in the Automatic Transfer Switch.
