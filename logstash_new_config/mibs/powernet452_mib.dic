        "severity" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.2.1.2.1.4",
            "status" : "obsolete",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "information" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "warning" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                    "severe" : {
                        "nodetype" : "namednumber",
                        "number" : "3"
                    },
                },
            },
            "access" : "readonly",
            "description" :
                """The severity threshold of traps to send to the manager.
traps are labeled in severity as informational(1), warning(2),
severe(3).  Only traps of equal or greater severity than
this value are sent to the manager.""",
        }, # column
        "acceptThisReceiver" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.2.1.2.1.5",
            "status" : "current",
            "syntax" : {
