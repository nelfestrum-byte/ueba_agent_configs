                """This gives access to Bank entries""",
        }, # row
        "rPDUStatusBankIndex" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.12.5.2.1.1",
            "status" : "current",
