            "oid" : "1.3.6.1.4.1.318.1.1.17.5.1",
        }, # node
        "xATSTestingStatusSelectTestProcess" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.17.5.1.1",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "engineStartTest" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "systemLoadTest" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                    "generatorHoldTest" : {
                        "nodetype" : "namednumber",
                        "number" : "3"
                    },
                    "cancelTest" : {
                        "nodetype" : "namednumber",
                        "number" : "4"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """Type of tests that can be selected when no test has been scheduled.
engineStartTest and systemLoadTest may be selected when no tests
are running.  Tests that are selected may be canceled manually.""",
        }, # scalar
        "xATSTestingStatusTestStatus" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.17.5.1.2",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "noTestInProcess" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "testPending" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                    "startingEngine" : {
                        "nodetype" : "namednumber",
                        "number" : "3"
                    },
                    "engineWarmingUp" : {
                        "nodetype" : "namednumber",
                        "number" : "4"
                    },
                    "awaitingTransferToS2" : {
                        "nodetype" : "namednumber",
                        "number" : "5"
                    },
                    "testingWithLoad" : {
                        "nodetype" : "namednumber",
                        "number" : "6"
                    },
                    "awaitingRetransferToS1" : {
                        "nodetype" : "namednumber",
                        "number" : "7"
                    },
                    "testingWithoutLoad" : {
                        "nodetype" : "namednumber",
                        "number" : "8"
                    },
                    "stoppingEngine" : {
                        "nodetype" : "namednumber",
                        "number" : "9"
                    },
                    "holdingOnGenerator" : {
                        "nodetype" : "namednumber",
                        "number" : "10"
                    },
                },
            },
            "access" : "readonly",
            "description" :
                """The present system test status/state.""",
        }, # scalar
        "xATSTestingStatusProfileWarmupTime" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.17.5.1.3",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readwrite",
            "description" :
                """The amount of time that the generator will warm up during a test.
This is portion of the test when the xATSTestingStatusTestStatus
OID returns the value engineWarmingUp.
Specified in seconds.""",
        }, # scalar
        "xATSTestingStatusProfileLoadedTime" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.17.5.1.4",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readwrite",
            "description" :
                """The amount of time that ATS will apply the system load to the generator
during a system load test.
This is portion of the test when the xATSTestingStatusTestStatus
OID returns the value testingWithLoad.
Specified in minutes.""",
        }, # scalar
        "xATSTestingStatusProfileUnloadedTime" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.17.5.1.5",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readwrite",
            "description" :
                """The amount of time that the generator will run following the warm up
portion of a start test, or the loaded portion of a load test.
This is portion of the test when the xATSTestingStatusTestStatus
OID returns the value testingWithoutLoad.
Specified in seconds.""",
        }, # scalar
