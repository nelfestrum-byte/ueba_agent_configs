        "upsDiagBatteryHealth" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.1.13.3.2.1.11",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "OctetString"},
            },
            "access" : "readonly",
            "description" :
                """The battery health.
bit 0 Battery lifetime okay
bit 1 Battery lifetime near end, order replacement module
bit 2 Battery lifetime exceeded, replace battery
bit 3 Battery lifetime near end acknowledged, order replacement module
bit 4 Battery lifetime exceeded acknowledged, replace battery
bit 5 Battery measured lifetime near end, order replacement module
bit 6 Battery measured lifetime near end acknowledged, order replacement module""",
        }, # column
