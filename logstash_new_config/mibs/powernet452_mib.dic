            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "outputRelayConfigCauseNone" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "outputRelayConfigCauseOnBatPwrFail" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                    "outputRelayConfigCauseOnBatPwrFailExceptPeakPeriod" : {
                        "nodetype" : "namednumber",
                        "number" : "3"
                    },
                    "outputRelayConfigCauseLoBatWhileOnBat" : {
                        "nodetype" : "namednumber",
                        "number" : "4"
                    },
                    "outputRelayConfigCauseAlarm" : {
                        "nodetype" : "namednumber",
                        "number" : "5"
                    },
                    "outputRelayConfigCauseFault" : {
                        "nodetype" : "namednumber",
                        "number" : "6"
                    },
                    "outputRelayConfigCauseOutputOn" : {
                        "nodetype" : "namednumber",
                        "number" : "7"
                    },
                    "outputRelayConfigCauseOutputOff" : {
                        "nodetype" : "namednumber",
                        "number" : "8"
                    },
                    "outputRelayConfigCauseOnline" : {
                        "nodetype" : "namednumber",
                        "number" : "9"
                    },
                    "outputRelayConfigCauseInBypass" : {
                        "nodetype" : "namednumber",
                        "number" : "10"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """This variable sets what causes the output relay state to change.
1 - none
2 - on battery power failure
3 - on battery power failure expect during peak period
4 - low battery while on battery
5 - alarm
6 - fault
7 - output on
8 - output off
9 - online
10 - in bypass""",
        }, # column
        "upsOutputRelayConfigPolarity" : {
            "nodetype" : "scalar",
