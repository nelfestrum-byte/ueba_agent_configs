        "sPDUOutletConfigMSPgsDeviceConfirm" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.6.6.2.1.1.6",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "deviceConfirmNo" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "deviceConfirmYes" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """Setting this OID to deviceConfirmNo (1) cause the outlet to
NOT wait for device confirmation while performing graceful
operations.

Setting this OID to deviceConfirmYes (2) cause the outlet to
wait for device confirmation while performing graceful
operations.""",
        }, # column
        "sPDUOutletConfigMSPgsLowBattWarning" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.6.6.2.1.1.7",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Integer32",
                    "ranges" : [
                    {
                        "min" : "-2",
                        "max" : "9999"
                    },
                    ],
                    "range" : {
                        "min" : "-2",
                        "max" : "9999"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """ The amount of delay, in 6 second intervals, between
when the UPS goes on battery and the power down sequence for
the outlet is initiated.

Allowed values are:

-2 - Never initiate the power down sequence on low battery warning.
-1 - Initiate power down sequence based on remaining runtime.
1 - 9999 six second intervals (6 secs - 16hrs, 39 mins, 54 secs).
0 indicates to immediately initiate power down sequence on low
 battery warning.""",
        }, # column
        "sPDUOutletConfigMSPgsLowBattMult" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.6.6.2.1.1.8",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Integer32",
                    "ranges" : [
                    {
                        "min" : "1",
                        "max" : "7"
                    },
                    ],
                    "range" : {
                        "min" : "1",
                        "max" : "7"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """ Only applicable if sPDUOutletConfigMSPgsLowBattWarning OID is
set to -1 (On Runtime Remaining).

Allows you to set the value to stagger the shutdown sequence of the outlets.
1 provides the longest delay (the outlet to shutoff first), and 7 would
provide the shortest delay (the outlet to shut off last).

Allowed values are:
1 - 7.""",
        }, # column
        "sPDUOutletConfigMSPgsRestartDelay" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.6.6.2.1.1.9",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Integer32",
                    "ranges" : [
                    {
                        "min" : "-1",
                        "max" : "9999"
                    },
                    ],
                    "range" : {
                        "min" : "-1",
                        "max" : "9999"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """ The amount of delay, in 6 minute intervals, between
when the outlet is turned off and the outlet is turned back on
when performing a Graceful Shutdown.

Allowed values are:

-1 - Never turn outlet back on after a Graceful shutdown.
0 - 9999 six minute intervals (0 - 999hrs, 54 mins).""",
        }, # column
        "sPDUOutletConfigMSPgsPowerOnDelay" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.6.6.2.1.1.10",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Integer32",
                    "ranges" : [
                    {
                        "min" : "-1",
                        "max" : "9999"
                    },
                    ],
                    "range" : {
                        "min" : "-1",
                        "max" : "9999"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """ The amount of delay, in seconds, between the UPS entering
normal (on-line) state and the outlet being powered on.

Allowed values are:

-1 - Remain Off when the UPS enters the on-line state.
0 - 9999 seconds (0 - 2 hrs, 46 mins, 39 secs).""",
        }, # column
        "sPDUOutletConfigMSPgsPowerOffDelay" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.6.6.2.1.1.11",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Integer32",
                    "ranges" : [
                    {
                        "min" : "0",
                        "max" : "9999"
                    },
                    ],
                    "range" : {
                        "min" : "0",
                        "max" : "9999"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """ The amount of delay, in seconds, between when the server
shuts down and the outlet is powered off.

Allowed values are:

0 - 9999 seconds (0 - 2 hrs, 46 mins, 39 secs).""",
        }, # column
        "sPDUOutletConfigMSPgsBattCapThresh" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.6.6.2.1.1.12",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Integer32",
                    "ranges" : [
                    {
                        "min" : "0",
                        "max" : "100"
                    },
                    ],
                    "range" : {
                        "min" : "0",
                        "max" : "100"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """ The minimum battery capacity, as a percent (0-100%), required
of the UPS before an outlet will be allowed to power on.

Allowed values are:

0 - 100 percent.""",
        }, # column
        "sPDUOutletConfigMSPgsRebootDuration" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.6.6.2.1.1.13",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Integer32",
                    "ranges" : [
                    {
                        "min" : "0",
                        "max" : "9999"
                    },
                    ],
                    "range" : {
                        "min" : "0",
                        "max" : "9999"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """ The amount of delay, in seconds, from outlet off until
outlet on during a reboot.

Allowed values are:

0 - 9999 seconds (0 - 2 hrs, 46 mins, 39 secs).""",
        }, # column
