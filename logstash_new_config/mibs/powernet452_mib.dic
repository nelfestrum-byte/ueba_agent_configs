        "xPDUBreakerPositionAlarm" : {
            "nodetype" : "notification",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.0.486",
            "status" : "current",
            "objects" : {
                "xPDUIdentSerialNumber" : {
                    "nodetype" : "object",
                    "module" : "PowerNet-MIB"
                },
