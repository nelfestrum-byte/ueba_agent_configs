                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """Configures whether the UPS will automatically restart
after an automatic shutdown.""",
        }, # scalar
        "upsAdvConfigAutoShutdownControlTimeOnBattery" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.1.5.2.64",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "upsAdvConfigDisableTimeOnBatteryAutoShutdown" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "upsAdvConfigEnableTimeOnBatteryAutoShutdown" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """Configures whether the UPS will turn off automatically
after the UPS device's time on battery has exceeded the
upsAdvConfigAutoShutdownTimeOnBattery OID setting.""",
        }, # scalar
        "upsAdvConfigAutoShutdownControlRuntimeRemaining" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.1.5.2.65",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "upsAdvConfigDisableRuntimeRemainingAutoShutdown" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "upsAdvConfigEnableRuntimeRemainingAutoShutdown" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """Configures whether the UPS will turn off when the UPS 
is on battery and the remaining runtime is less than 
the upsAdvConfigAutoShutdownRuntimeRemaining OID
setting.""",
        }, # scalar
        "upsAdvConfigAutoShutdownTimeOnBattery" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.1.5.2.66",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"SNMPv2-SMI", "name" : "TimeTicks"},
            },
            "access" : "readwrite",
            "description" :
                """When the UPS has been on battery for more time than this
value, the UPS will turn off if this condition is
enabled by the upsAdvConfigAutoShutdownControlTimeOnBattery
OID.""",
        }, # scalar
        "upsAdvConfigAutoShutdownRuntimeRemaining" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.1.5.2.67",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"SNMPv2-SMI", "name" : "TimeTicks"},
            },
            "access" : "readwrite",
            "description" :
                """When the UPS runtime remaining is less than this setting,
the UPS will turn off if this condition is enabled by the 
upsAdvConfigAutoShutdownControlRuntimeRemaining OID.""",
        }, # scalar
        "upsAdvConfigHighLLTransferVolt" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.1.5.2.68",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readwrite",
            "description" :
                """The maximum line to line voltage in VAC allowed before the
UPS system transfers to battery backup.

For a list of allowed values supported by your UPS model,
see the UPS User's Manual.

If a value other than a supported value is provided in a
set request, the UPS interprets it as the next higher
acceptable value.  If the provided value is higher than
the highest acceptable value, the highest acceptable
value is used.""",
        }, # scalar
        "upsAdvConfigLowLLTransferVolt" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.1.5.2.69",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readwrite",
            "description" :
                """The minimum line to line voltage in VAC allowed before the
UPS system transfers to battery backup.

For a list of allowed values supported by your UPS model,
see the UPS User's Manual.

If a value other than a supported value is provided in a
set request, the UPS interprets it as the next lower
acceptable value.  If the provided value is lower than
the lowest acceptable value, the lowest acceptable
value is used.""",
        }, # scalar
        "upsAdvConfigHighBypassTransferVolt" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.1.5.2.70",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readwrite",
            "description" :
                """The maximum line voltage, in VAC, that the
UPS system will allow a transfer to bypass.""",
        }, # scalar
