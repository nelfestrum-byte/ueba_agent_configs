            "oid" : "1.3.6.1.4.1.318.1.1.13.1.4.5.4",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readwrite",
            "description" :
                """Set the delay between opening the Economizer Isolator
output relay and engaging the compressors.  Measured
