            ],
            "description" :
                """This gives access to Monitored Outlet entries""",
        }, # row
        "rPDUOutletConfigMonitoredIndex" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.12.3.4.3.1.1",
