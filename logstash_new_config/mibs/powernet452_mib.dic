                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """Close or open the output relay for testing purposes. Always
returns 1 when read.
1 - close output relay
2 - open output relay""",
        }, # column
        "uioOutputRelayConfigDelay" : {
            "nodetype" : "column",
