                    "disableFrontPanel" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "enableFrontPanel" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """This is the configurable lockout status of the source preference toggle button
on the front panel. The button does nothing while the front panel is locked.""",
        }, # column
        "ats5gSwitchConfigPreferredSource" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.33.3.1.7",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "sourceA" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "sourceB" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                    "none" : {
                        "nodetype" : "namednumber",
                        "number" : "3"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """This is the configurable source preference. If the ATS is fully redundant the
preferred source will be the selected source. If the preferred source is none(3),
the ATS will switch sources only in response to measured changes in each source.""",
        }, # column
        "ats5gSwitchSelectedSource" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.33.3.1.8",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "sourceA" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "sourceB" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                    "none" : {
                        "nodetype" : "namednumber",
                        "number" : "3"
                    },
                },
            },
            "access" : "readonly",
            "description" :
                """This is the selected source that will be used to power downstream devices.""",
        }, # column
        "ats5gSwitchRedundancyState" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.33.3.1.9",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "atsRedundancyLost" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "atsFullyRedundant" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                },
            },
            "access" : "readonly",
            "description" :
                """This is the ATS redundancy status. While this value is atsFullyRedundant(2),
either input may be used to power downstream devices. While this value is
atsRedundancyLost(1), one input has failed validation and downstream devices
may lose power if the selected source is lost.""",
        }, # column
        "ats5gSwitchSourceAStatus" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.33.3.1.10",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "fail" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "ok" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                },
            },
            "access" : "readonly",
            "description" :
                """This is the input status of source A. The ATS will use source B as the selected source
while this value is fail(1).""",
        }, # column
        "ats5gSwitchSourceBStatus" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.33.3.1.11",
