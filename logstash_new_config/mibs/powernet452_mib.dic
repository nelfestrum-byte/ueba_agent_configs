                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readwrite",
            "description" :
                """Lower Limit of ECO Voltage Range in Volts.""",
        }, # scalar
        "upsAdvConfigEcoVoltageRangeUpperLimit" : {
