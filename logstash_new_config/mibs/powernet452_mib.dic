                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "upsAdvConfigUseOffDelayAutoShutdown" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """Configures whether the UPS device's off delay setting
(upsAdvConfigShutoffDelay) will be used for automatic shutdown.""",
        }, # scalar
        "upsAdvConfigAutoShutdownControlAutoRestart" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.1.5.2.63",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "upsAdvConfigControlAutoRestartAutoShutdown" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
