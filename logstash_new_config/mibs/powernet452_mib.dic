            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readwrite",
            "description" :
                """User-defined near bank overload current warning
threshold in tenths of Amps""",
        }, # column
        "rPDU2AdvBankConfigOverloadCurrentThreshold" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.26.14.1.1.7",
