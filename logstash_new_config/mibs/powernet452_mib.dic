        "upsAdvConfigAutoShutdownControlBatteryCapacity" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.1.5.2.74",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "upsAdvConfigDisableBatteryCapacityAutoShutdown" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "upsAdvConfigEnableBatteryCapacityAutoShutdown" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """This setting only shuts down the UPS when the UPS is on battery and
when the battery capacity is less than the
upsAdvConfigAutoShutdownBatteryCapacity OID setting.""",
        }, # scalar
        "upsAdvConfigAutoShutdownBatteryCapacity" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.1.5.2.75",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readwrite",
            "description" :
                """When the Battery capacity is less than this value,
the UPS will turn off, if this condition is enabled by
upsAdvConfigAutoShutdownControlBatteryCapacity OID 
setting.""",
        }, # scalar
        "upsAdvConfigAutoShutdownControlLoadPercentOnUps" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.1.5.2.76",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "upsAdvConfigDisableLoadPercentOnUpsAutoShutdown" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "upsAdvConfigEnableLoadPercentOnUpsAutoShutdown" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """This setting only shuts down the UPS when the UPS is on battery and
when the load percent on UPS is less than the
upsAdvConfigAutoShutdownLoadPercentOnUps OID setting.""",
        }, # scalar
        "upsAdvConfigAutoShutdownLoadPercentOnUps" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.1.5.2.77",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readwrite",
            "description" :
                """When the Load percent on UPS is less than this value,
the UPS will turn off, if this condition is enabled by the
upsAdvConfigAutoShutdownControlLoadPercentOnUps OID
setting.""",
        }, # scalar
        "upsAdvConfigBypassFrequencyRangeLowerLimit" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.1.5.2.78",
