            },
            "access" : "readwrite",
            "description" :
                """Getting/setting this OID will return/set the
Power Factor in thousandths (1000 is power factor of 1).
This OID is only writable for AP7xxx SKUs

Valid range is from 0 to 1000.""",
        }, # scalar
        "rPDUIdentDevicePowerVA" : {
            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.12.1.18",
