        "upsOutletGroupConfigLoadShedControlTimeOnBattery" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.1.12.2.2.1.10",
