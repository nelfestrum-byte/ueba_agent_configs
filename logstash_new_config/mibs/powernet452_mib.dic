                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "upsOutletGroupConfigEnableInOverloadLoadShed" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """Configures whether the outlet group will load shed (turn off)
when the UPS is in an overload condition. The setting for
upsOutletGroupConfigLoadShedControlSkipOffDelay is valid for
this load shed condition. Returns -1 if not supported by this
outlet group.""",
        }, # column
        "upsOutletGroupConfigLoadShedTimeOnBattery" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.1.12.2.2.1.13",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
