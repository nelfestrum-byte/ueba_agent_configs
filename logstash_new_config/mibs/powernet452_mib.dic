                    "fail" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "ok" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                },
            },
            "access" : "readonly",
            "description" :
                """This is the input status of source B. The ATS will use source A as the selected source
while this value is fail(1).""",
        }, # column
        "ats5gSwitchRatedVoltage" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.33.3.1.12",
