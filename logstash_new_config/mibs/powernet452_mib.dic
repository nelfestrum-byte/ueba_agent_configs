            "oid" : "1.3.6.1.4.1.318.1.1.12.3.4.1",
            "status" : "current",
            "description" :
                """Allows for configuration of individual outlets. The number of
entries is contained in the rPDUOutletDevNumCntrlOutlets OID.""",
        }, # table
        "rPDUOutletConfigEntry" : {
            "nodetype" : "row",
