        "isxModularDistModuleOutputStatus" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.22.2.6.1.6",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "normal" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "warning" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                    "critical" : {
                        "nodetype" : "namednumber",
                        "number" : "3"
                    },
                    "notPresent" : {
                        "nodetype" : "namednumber",
                        "number" : "4"
                    },
                    "unknown" : {
                        "nodetype" : "namednumber",
                        "number" : "6"
                    },
                },
            },
            "access" : "readonly",
            "description" :
                """This reflects the worse case severity for alarms associated with this distribution cable.
A value of notPresent indicates that the cable does not exist for this module.
A value of unknown indicates that the there is no communication with the
metering segment for this distribution cable's module.""",
        }, # column
        "isxModularDistModuleOutputAlarmGeneration" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.22.2.6.1.7",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "disabled" : {
                        "nodetype" : "namednumber",
