        }, # column
        "ats5gSwitchConfigNominalVoltage" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.33.3.1.13",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readwrite",
            "description" :
                """This is the configurable line VRMS in volts (V) that will be used to select sources.""",
        }, # column
        "ats5gSwitchConfigTransferVoltageRange" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.33.3.1.14",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "wide" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "medium" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                    "narrow" : {
                        "nodetype" : "namednumber",
                        "number" : "3"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """This value specifies which voltage transfer range should be used to disqualify
sources and raise alarms. The narrow transfer voltage must be less than the medium
transfer voltage, which must be less than the wide transfer voltage.
If the difference between ats5gSwitchConfigNominalVoltage and a source's measured VRMS
is greater than the value specified by the selected transfer range, the ATS will
disqualify that source. The ATS will be in a 'lost redundancy' state until the source
recovers or the configuration is updated.""",
        }, # column
        "ats5gSwitchConfigTransferVoltageWide" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.33.3.1.15",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readwrite",
            "description" :
                """This is the configurable transfer range in volts (V) used to disqualify sources when
ats5gSwitchConfigTransferVoltageRange is wide(1).""",
        }, # column
        "ats5gSwitchConfigTransferVoltageMedium" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.33.3.1.16",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readwrite",
            "description" :
                """This is the configurable transfer range in volts (V) used to disqualify sources when
ats5gSwitchConfigTransferVoltageRange is medium(2).""",
        }, # column
        "ats5gSwitchConfigTransferVoltageNarrow" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.33.3.1.17",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readwrite",
            "description" :
                """This is the configurable transfer range in volts (V) used to disqualify sources when
ats5gSwitchConfigTransferVoltageRange is narrow(3).""",
        }, # column
        "ats5gSwitchConfigVoltageSensitivity" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.33.3.1.18",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "high" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "low" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """This is the configured sensitivity threshold for rapid changes to input voltage.
It is recommended to use high(1) unless frequent small changes are expected.""",
        }, # column
        "ats5gSwitchSourceAVoltage" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.33.3.1.19",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readonly",
            "description" :
                """This is the measured line VRMS of source A reported in volts (V).""",
        }, # column
        "ats5gSwitchSourceBVoltage" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.33.3.1.20",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readonly",
