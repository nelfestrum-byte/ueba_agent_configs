        }, # column
        "ats5gSwitchRatedFrequency" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.33.3.1.21",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readonly",
            "description" :
                """This is the default nominal line frequency for this unit reported in Hertz (Hz).""",
        }, # column
        "ats5gSwitchConfigNominalFrequency" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.33.3.1.22",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readwrite",
            "description" :
                """This is the configurable line frequency in Hertz (Hz) that will be used to select
sources. If the difference between ats5gSwitchConfigNominalFrequency and a source's
measured frequency is greater than ats5gSwitchConfigFrequencyDeviation, the ATS will
disqualify that source. The ATS will be in a 'lost redundancy' state until the source
recovers or the configuration is updated.""",
        }, # column
        "ats5gSwitchConfigFrequencyDeviation" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.33.3.1.23",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "one" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "two" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                    "three" : {
                        "nodetype" : "namednumber",
                        "number" : "3"
                    },
                    "five" : {
                        "nodetype" : "namednumber",
                        "number" : "5"
                    },
                    "ten" : {
                        "nodetype" : "namednumber",
                        "number" : "10"
                    },
                },
            },
            "access" : "readwrite",
            "description" :
                """This is the configurable frequency deviation in Hertz (Hz) that will be used to select
sources.""",
        }, # column
        "ats5gSwitchSourceAFrequency" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.33.3.1.24",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readonly",
            "description" :
                """This is the measured line frequency of source A reported in Hertz (Hz).""",
        }, # column
        "ats5gSwitchSourceBFrequency" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.33.3.1.25",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readonly",
            "description" :
                """This is the measured line frequency of source B reported in Hertz (Hz).""",
        }, # column
        "ats5gSwitchEventCountStartTime" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
