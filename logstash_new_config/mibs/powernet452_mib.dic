            "nodetype" : "scalar",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.12.3.4.2",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readonly",
            "description" :
                """The size of the Outlet Config Monitored Table""",
