        "isxModularDistModuleInfoAlarmStatus" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.22.2.2.1.2",
            "status" : "current",
            "syntax" : {
                "type" :                 {
                    "basetype" : "Enumeration",
                    "normal" : {
                        "nodetype" : "namednumber",
                        "number" : "1"
                    },
                    "warning" : {
                        "nodetype" : "namednumber",
                        "number" : "2"
                    },
                    "critical" : {
                        "nodetype" : "namednumber",
                        "number" : "3"
                    },
                    "notPresent" : {
