        "xATSGeneratorEStop" : {
            "nodetype" : "notification",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.0.439",
            "status" : "current",
            "objects" : {
                "xATSIdentSerialNumber" : {
                    "nodetype" : "object",
                    "module" : "PowerNet-MIB"
                },
                "xATSIdentProductName" : {
                    "nodetype" : "object",
                    "module" : "PowerNet-MIB"
                },
