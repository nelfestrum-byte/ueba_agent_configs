        }, # row
        "xATSSwitchBlockMapIndex" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.17.3.4.2.1.1",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readonly",
            "description" :
                """Index of blocking map entries in the table.""",
        }, # column
        "xATSSwitchBlockMapName" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.17.3.4.2.1.2",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"RFC1213-MIB", "name" : "DisplayString"},
            },
            "access" : "readonly",
            "description" :
                """A string describing the ATS action to be blocked.""",
        }, # column
        "xATSSwitchBlockMapStatus" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.17.3.4.2.1.3",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readonly",
            "description" :
                """Represents the status of this blocking map entry, in bit-mapped format.
A non-zero value indicates that this entry's ATS action is currently being blocked.
The bit(s) set indicate which input(s) are causing the blocking (bit0, bit1, etc).

bit 0 - Contact 1
bit 1 - Contact 2
bit 2 - Contact 3
bit 3 - Contact 4.""",
        }, # column
        "xATSSwitchBlockMapSetting" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.17.3.4.2.1.4",
            "status" : "current",
            "syntax" : {
                "type" : { "module" :"", "name" : "Integer32"},
            },
            "access" : "readwrite",
            "description" :
                """This setting designates the inputs that block the ATS action
The mapping is specified as a bit-field, where each bit set indicates
the input that blocks the ATS action associated with the entry.

bit 0 - Contact 1
bit 1 - Contact 2
bit 2 - Contact 3
bit 3 - Contact 4.""",
        }, # column
