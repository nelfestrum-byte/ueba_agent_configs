        }, # column
        "rPDULoadBankConfigNearOverloadThreshold" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.12.2.4.1.1.3",
            "status" : "current",
