        }, # column
        "rPDU2SensorTempHumidityStatusTempC" : {
            "nodetype" : "column",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.1.1.26.10.2.2.1.8",
