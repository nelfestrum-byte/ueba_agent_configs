        "xATSRemoteStartContactMismatch" : {
            "nodetype" : "notification",
            "moduleName" : "PowerNet-MIB",
            "oid" : "1.3.6.1.4.1.318.0.417",
            "status" : "current",
            "objects" : {
                "xATSIdentSerialNumber" : {
                    "nodetype" : "object",
                    "module" : "PowerNet-MIB"
                },
                "xATSIdentProductName" : {
