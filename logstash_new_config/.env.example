# ─────────────────────────────────────────────────────────────────────────────
# Переименуйте в .env и заполните перед деплоем.
# ─────────────────────────────────────────────────────────────────────────────

# OpenSearch — используется всеми тремя пайплайнами
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=changeme

# SSL
OPENSEARCH_SSL=true
OPENSEARCH_SSL_VERIFY=false
# Путь к CA внутри контейнера (оставьте пустым если SSL_VERIFY=false)
OPENSEARCH_CA_CERT=

# Logstash: JVM heap
LS_JAVA_OPTS=-Xms1g -Xmx1g

# Bind-адрес для портов (0.0.0.0 = все интерфейсы, или укажите IP)
LOGSTASH_BIND_ADDR=0.0.0.0
