## /etc/audit/rules.d/ueba.rules
## Правила auditd для UEBA — собирают события, типичные для аналитики ИБ.
## Покрытие: процессы, аутентификация, изменения учёток/прав/sudo, SSH-ключи,
## cron/systemd, сеть, модули ядра, подозрительные пути, эскалация привилегий,
## изменения времени, монтирование, ptrace, целостность audit/MAC/PAM,
## tampering с журналами входов и shell-историей.

# Очищаем все предыдущие правила
-D

# Увеличиваем буфер и failure-режим (1 = printk, не паника)
-b 16384
-f 1

# Игнорируем шум от самого auditd, чтобы не зацикливать
-a never,exit -F arch=b64 -S all -F exe=/usr/sbin/auditd
-a never,exit -F arch=b64 -S all -F exe=/sbin/auditd

# В проде включить immutable mode (после загрузки правил их нельзя менять до reboot)
# -e 2

# ── Запуск процессов (execve) ──────────────────────────────────────────────
-a always,exit -F arch=b64 -S execve -k process_start
-a always,exit -F arch=b32 -S execve -k process_start

# ── Аутентификация / PAM ───────────────────────────────────────────────────
-w /etc/pam.d/                -p wa -k pam_changes
-w /etc/security/             -p wa -k security_changes
-w /etc/nsswitch.conf         -p wa -k nss_changes
-w /etc/login.defs            -p wa -k login_defs
-w /etc/securetty             -p wa -k securetty

# ── Изменения пользователей и групп ───────────────────────────────────────
-w /etc/passwd   -p wa -k user_changes
-w /etc/shadow   -p wa -k user_changes
-w /etc/group    -p wa -k user_changes
-w /etc/gshadow  -p wa -k user_changes
-w /etc/sudoers  -p wa -k sudo_changes
-w /etc/sudoers.d/ -p wa -k sudo_changes

# ── Использование privileged команд (типичные SUID/sudo) ──────────────────
-w /usr/bin/sudo     -p x -k privileged_cmd
-w /usr/bin/su       -p x -k privileged_cmd
-w /usr/bin/passwd   -p x -k privileged_cmd
-w /usr/bin/chage    -p x -k privileged_cmd
-w /usr/bin/gpasswd  -p x -k privileged_cmd
-w /usr/bin/newgrp   -p x -k privileged_cmd
-w /usr/bin/chsh     -p x -k privileged_cmd
-w /usr/bin/usermod  -p x -k privileged_cmd
-w /usr/sbin/useradd -p x -k privileged_cmd
-w /usr/sbin/userdel -p x -k privileged_cmd
-w /usr/sbin/groupadd -p x -k privileged_cmd
-w /usr/sbin/visudo  -p x -k privileged_cmd

# ── SSH ключи и конфиг ─────────────────────────────────────────────────────
-a always,exit -F arch=b64 -S open,openat -F dir=/root/.ssh -k ssh_keys
-a always,exit -F arch=b64 -S open,openat -F dir=/home -F name=authorized_keys -k ssh_keys
-w /etc/ssh/sshd_config       -p wa -k sshd_config
-w /etc/ssh/sshd_config.d/    -p wa -k sshd_config

# ── Cron и systemd таймеры/юниты (persistence) ─────────────────────────────
-w /etc/cron.allow            -p wa -k cron_changes
-w /etc/cron.deny             -p wa -k cron_changes
-w /etc/cron.d/               -p wa -k cron_changes
-w /etc/cron.daily/           -p wa -k cron_changes
-w /etc/cron.hourly/          -p wa -k cron_changes
-w /etc/cron.monthly/         -p wa -k cron_changes
-w /etc/cron.weekly/          -p wa -k cron_changes
-w /etc/crontab               -p wa -k cron_changes
-w /var/spool/cron/           -p wa -k cron_changes
-w /etc/systemd/              -p wa -k systemd_changes
-w /usr/lib/systemd/system/   -p wa -k systemd_changes
-w /lib/systemd/system/       -p wa -k systemd_changes
-w /etc/init.d/               -p wa -k init_changes
-w /etc/rc.local              -p wa -k init_changes

# ── Сетевые настройки и DNS ───────────────────────────────────────────────
-a always,exit -F arch=b64 -S socket -F a0=2  -k socket_create
-a always,exit -F arch=b64 -S socket -F a0=10 -k socket_create
-a always,exit -F arch=b64 -S bind    -k socket_bind
-a always,exit -F arch=b64 -S listen  -k socket_listen
-a always,exit -F arch=b64 -S connect -k socket_connect
-a always,exit -F arch=b64 -S sethostname,setdomainname -k network_id
-w /etc/hosts                 -p wa -k network_config
-w /etc/hostname              -p wa -k network_config
-w /etc/resolv.conf           -p wa -k network_config
-w /etc/nsswitch.conf         -p wa -k network_config
-w /etc/network/              -p wa -k network_config
-w /etc/netplan/              -p wa -k network_config
-w /etc/sysconfig/network-scripts/ -p wa -k network_config
-w /etc/iptables/             -p wa -k firewall_changes
-w /etc/nftables.conf         -p wa -k firewall_changes
-w /etc/ufw/                  -p wa -k firewall_changes

# ── Модули ядра и kexec ──────────────────────────────────────────────────
-a always,exit -F arch=b64 -S init_module,finit_module -k module_load
-a always,exit -F arch=b64 -S delete_module -k module_unload
-w /etc/modprobe.conf         -p wa -k module_config
-w /etc/modprobe.d/           -p wa -k module_config
-w /etc/modules               -p wa -k module_config
-w /etc/modules-load.d/       -p wa -k module_config

# ── Параметры ядра (sysctl) ──────────────────────────────────────────────
-w /etc/sysctl.conf           -p wa -k sysctl_changes
-w /etc/sysctl.d/             -p wa -k sysctl_changes

# ── Подозрительные пути и script-движки ──────────────────────────────────
-a always,exit -F arch=b64 -S execve -F dir=/tmp     -k suspicious_exec
-a always,exit -F arch=b64 -S execve -F dir=/dev/shm -k suspicious_exec
-a always,exit -F arch=b64 -S execve -F dir=/var/tmp -k suspicious_exec
-a always,exit -F arch=b32 -S execve -F dir=/tmp     -k suspicious_exec
-a always,exit -F arch=b32 -S execve -F dir=/dev/shm -k suspicious_exec
-a always,exit -F arch=b32 -S execve -F dir=/var/tmp -k suspicious_exec

# ── Эскалация привилегий через syscalls ──────────────────────────────────
-a always,exit -F arch=b64 -S setuid,setgid,setresuid,setresgid -k privilege_change
-a always,exit -F arch=b32 -S setuid,setgid,setresuid,setresgid -k privilege_change

# ── Изменение прав/владельца на файлах (chmod/chown) ─────────────────────
## EUID>=1000 AUID>=1000 чтобы не утонуть в системном шуме (root-демоны)
-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S chown,fchown,fchownat,lchown -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b32 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b32 -S chown,fchown,fchownat,lchown -F auid>=1000 -F auid!=unset -k perm_mod

# ── Удаление/переименование файлов (массовые удаления, anti-forensics) ───
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat,renameat2 -F auid>=1000 -F auid!=unset -k file_delete
-a always,exit -F arch=b32 -S unlink,unlinkat,rename,renameat,renameat2 -F auid>=1000 -F auid!=unset -k file_delete

# ── Расширенные атрибуты и file capabilities ─────────────────────────────
-a always,exit -F arch=b64 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -k xattr_change
-a always,exit -F arch=b32 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -k xattr_change

# ── ptrace / process injection ───────────────────────────────────────────
-a always,exit -F arch=b64 -S ptrace -k ptrace
-a always,exit -F arch=b32 -S ptrace -k ptrace

# ── Mount/umount/chroot/pivot_root (включая попытки побега из контейнера) ─
-a always,exit -F arch=b64 -S mount,umount2 -k mount
-a always,exit -F arch=b32 -S mount,umount,umount2 -k mount
-a always,exit -F arch=b64 -S chroot,pivot_root -k chroot
-a always,exit -F arch=b32 -S chroot -k chroot

# ── Изменение системного времени ─────────────────────────────────────────
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k time_change
-a always,exit -F arch=b32 -S adjtimex,settimeofday,clock_settime,stime -k time_change
-w /etc/localtime             -p wa -k time_change
-w /etc/timezone              -p wa -k time_change

# ── Целостность журналов входов (tampering с utmp/wtmp/btmp/lastlog) ─────
-w /var/run/utmp              -p wa -k session_logs
-w /var/log/wtmp              -p wa -k session_logs
-w /var/log/btmp              -p wa -k session_logs
-w /var/log/lastlog           -p wa -k session_logs

# ── Целостность аудита и его конфигурации ────────────────────────────────
-w /etc/audit/                -p wa -k audit_config
-w /etc/libaudit.conf         -p wa -k audit_config
-w /etc/audisp/               -p wa -k audit_config
-w /var/log/audit/            -p wa -k audit_logs
-w /sbin/auditctl             -p x  -k audit_tools
-w /sbin/auditd               -p x  -k audit_tools
-w /usr/sbin/auditctl         -p x  -k audit_tools
-w /usr/sbin/auditd           -p x  -k audit_tools

# ── MAC: AppArmor / SELinux ──────────────────────────────────────────────
-w /etc/apparmor/             -p wa -k mac_changes
-w /etc/apparmor.d/           -p wa -k mac_changes
-w /etc/selinux/              -p wa -k mac_changes

# ── Shell-конфиги и история (persistence + anti-forensics) ──────────────
-w /etc/bash.bashrc           -p wa -k shell_config
-w /etc/profile               -p wa -k shell_config
-w /etc/profile.d/            -p wa -k shell_config
-w /etc/shells                -p wa -k shell_config
-w /etc/environment           -p wa -k shell_config
-w /etc/skel/                 -p wa -k shell_config

# ── Конфиги пакетного менеджера (supply-chain) ──────────────────────────
-w /etc/apt/                  -p wa -k pkg_config
-w /etc/dpkg/                 -p wa -k pkg_config
