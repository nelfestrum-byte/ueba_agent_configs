{
  "//": "/etc/osquery/osquery.conf — production, bare-metal Debian",
  "//install": "apt install osquery (репозиторий https://pkg.osquery.io/deb/) && systemctl enable --now osqueryd",
  "//flags": "доп. флаги — в /etc/osquery/osquery.flags (database_path, pidfile, schedule_dir уже выставлены пакетом)",
  "//note": "audit-подсистема osquery отключена (disable_audit=true), чтобы не конфликтовать с auditd. Kernel audit события собирает auditd через fluent-bit.",

  "options": {
    "config_plugin": "filesystem",
    "logger_plugin": "filesystem",
    "logger_path": "/var/log/osquery",
    "logger_min_status": "1",
    "logger_min_stderr": "1",
    "logger_rotate": "true",
    "logger_rotate_max_files": "10",
    "logger_rotate_max_bytes": "104857600",
    "disable_logging": "false",
    "log_result_events": "true",

    "schedule_splay_percent": "20",
    "schedule_default_interval": "3600",
    "utc": "true",
    "host_identifier": "hostname",
    "enable_monitor": "true",
    "disable_events": "false",
    "events_expiry": "3600",
{% if osquery_bpf_events_enabled | default(false) %}
    "enable_bpf_events": "true",
    "bpf_buffer_storage_size": "1024",
    "bpf_perf_event_array_exp": "14",
{% endif %}
    "disable_audit": "true",
    "audit_allow_config": "false",
    "audit_allow_sockets": "false",

    "watchdog_level": "0",
    "watchdog_memory_limit": "350",
    "watchdog_utilization_limit": "130",
    "watchdog_delay": "60",

    "enable_numeric_monitoring": "false",

    "disable_carver": "true",
    "disable_distributed": "true"
  },

  "schedule": {

    "listening_ports": {
      "query": "SELECT l.pid, p.name AS process_name, l.port, l.protocol, l.address, p.uid, u.username, (SELECT hostname FROM system_info) AS hostname FROM listening_ports l LEFT JOIN processes p ON l.pid = p.pid LEFT JOIN users u ON p.uid = u.uid",
      "interval": 60
    },

    "processes": {
      "query": "SELECT p.pid, p.name, p.path, p.cmdline, p.uid, p.parent, p.start_time, u.username, (SELECT name FROM processes WHERE pid = p.parent LIMIT 1) AS parent_name, (SELECT hostname FROM system_info) AS hostname FROM processes p LEFT JOIN users u ON p.uid = u.uid WHERE p.uid >= 1000 AND p.path != '' AND p.path IS NOT NULL",
      "interval": 30
    },

    "users": {
      "query": "SELECT uid, username, description, directory, shell, (SELECT hostname FROM system_info) AS hostname FROM users",
      "interval": 120
    },

    "crontabs": {
      "query": "SELECT c.command, c.path, c.minute, c.hour, c.day_of_month, c.month, c.day_of_week, CASE WHEN c.path LIKE '/var/spool/cron/crontabs/%' THEN substr(c.path, 26) ELSE 'root' END AS username, (SELECT uid FROM users WHERE username = CASE WHEN c.path LIKE '/var/spool/cron/crontabs/%' THEN substr(c.path, 26) ELSE 'root' END LIMIT 1) AS uid, (SELECT hostname FROM system_info) AS hostname FROM crontab c",
      "interval": 60
    },

    "ssh_authorized_keys": {
      "query": "SELECT authorized_keys.uid, authorized_keys.key, authorized_keys.key_file, users.username, (SELECT hostname FROM system_info) AS hostname FROM authorized_keys JOIN users USING(uid)",
      "interval": 60
    },

    "kernel_modules": {
      "query": "SELECT name, size, status, address, (SELECT hostname FROM system_info) AS hostname FROM kernel_modules",
      "interval": 60
    },

    "logged_in_users": {
      "query": "SELECT user, type, host, time, pid, (SELECT hostname FROM system_info) AS hostname FROM logged_in_users",
      "interval": 30
    },

    "process_connections": {
      "query": "SELECT pos.pid, pos.remote_address, pos.remote_port, pos.local_address, pos.local_port, pos.protocol, pos.state, p.name AS process_name, p.path AS process_path, u.username, (SELECT hostname FROM system_info) AS hostname FROM process_open_sockets pos JOIN processes p ON pos.pid = p.pid LEFT JOIN users u ON p.uid = u.uid WHERE pos.remote_address != '' AND pos.remote_address NOT IN ('0.0.0.0', '::', '127.0.0.1', '::1')",
      "interval": 30
    },

    "pci_devices": {
      "query": "SELECT pci_slot, pci_class, vendor, vendor_id, model, model_id, (SELECT hostname FROM system_info) AS hostname FROM pci_devices",
      "interval": 300
    },

    "usb_devices": {
      "query": "SELECT usb_address, usb_port, vendor, vendor_id, version, model, model_id, serial, removable, (SELECT hostname FROM system_info) AS hostname FROM usb_devices",
      "interval": 30
    },

    "routes": {
      "query": "SELECT destination, netmask, gateway, interface, type, flags, (SELECT hostname FROM system_info) AS hostname FROM routes WHERE type NOT IN ('local', 'broadcast')",
      "interval": 120
    },

    "arp_cache": {
      "query": "SELECT address, mac, interface, (SELECT hostname FROM system_info) AS hostname FROM arp_cache WHERE address NOT IN ('127.0.0.1', '::1')",
      "interval": 60
    },

    "sudoers": {
      "query": "SELECT header, rule_details, (SELECT hostname FROM system_info) AS hostname FROM sudoers",
      "interval": 120
    },

    "mounts": {
      "query": "SELECT device, path, type, flags, (SELECT hostname FROM system_info) AS hostname FROM mounts WHERE type NOT IN ('proc', 'sysfs', 'devtmpfs', 'devpts', 'tmpfs', 'securityfs', 'cgroup', 'cgroup2', 'pstore', 'bpf', 'autofs', 'mqueue', 'hugetlbfs', 'debugfs', 'tracefs', 'configfs', 'fusectl', 'efivarfs')",
      "interval": 120
    },

    "iptables": {
      "query": "SELECT filter_name, chain, policy, target, match, src_ip, dst_ip, (SELECT hostname FROM system_info) AS hostname FROM iptables",
      "interval": 300
    },

    "dns_resolvers": {
      "query": "SELECT id, type, address, netmask, options, (SELECT hostname FROM system_info) AS hostname FROM dns_resolvers",
      "interval": 120
    },

    "suid_bins": {
      "query": "SELECT path, username, groupname, permissions, (SELECT hostname FROM system_info) AS hostname FROM suid_bin",
      "interval": 3600
    },

    "certificates": {
      "query": "SELECT common_name, subject, issuer, ca, self_signed, not_valid_after, sha256, path, (SELECT hostname FROM system_info) AS hostname FROM certificates WHERE ca = '1' OR self_signed = '1'",
      "interval": 3600
    },

    "process_open_files": {
      "query": "SELECT p.pid, p.name, p.path AS process_path, pof.path AS file_path, pof.fd, u.username, (SELECT hostname FROM system_info) AS hostname FROM process_open_files pof JOIN processes p ON pof.pid = p.pid LEFT JOIN users u ON p.uid = u.uid WHERE p.uid >= 1000 AND pof.path NOT LIKE '/proc/%' AND pof.path NOT LIKE '/dev/%' AND pof.path NOT LIKE '/sys/%' AND pof.path != ''",
      "interval": 60
    },

    "startup_items": {
      "query": "SELECT name, path, args, type, source, status, username, (SELECT hostname FROM system_info) AS hostname FROM startup_items",
      "interval": 300
    },

    "groups": {
      "query": "SELECT gid, groupname, (SELECT hostname FROM system_info) AS hostname FROM groups",
      "interval": 120
    },

    "user_groups": {
      "query": "SELECT ug.uid, ug.gid, u.username, g.groupname, (SELECT hostname FROM system_info) AS hostname FROM user_groups ug LEFT JOIN users u ON ug.uid = u.uid LEFT JOIN groups g ON ug.gid = g.gid",
      "interval": 120
    },

    "etc_hosts": {
      "query": "SELECT address, hostnames, (SELECT hostname FROM system_info) AS hostname FROM etc_hosts WHERE address NOT IN ('127.0.0.1', '::1', '127.0.1.1', 'fe00::0', 'ff00::0', 'ff02::1', 'ff02::2', 'ff02::3')",
      "interval": 120
    },

    "shell_history": {
      "query": "SELECT uid, username, command, history_file FROM shell_history;",
      "interval": 300,
      "removed": false,
      "description": "User command history (bash/zsh) — UEBA sequence anomalies (P2-02)"
    },

    "last_logins": {
      "query": "SELECT username, tty, host AS source_host, time, type FROM last WHERE type IN (7,8);",
      "interval": 300,
      "removed": false,
      "description": "User login/logout sessions from utmp/wtmp — cross-check with auditd USER_LOGIN (P2-02)"
    },

    "preload_envs": {
      "query": "SELECT pe.pid, pe.key, pe.value, p.name AS process_name, p.path AS process_path, p.cmdline FROM process_envs pe JOIN processes p ON p.pid = pe.pid WHERE pe.key IN ('LD_PRELOAD','LD_AUDIT','LD_LIBRARY_PATH') AND pe.value != '';",
      "interval": 60,
      "removed": false,
      "description": "Processes with LD_PRELOAD/LD_AUDIT/LD_LIBRARY_PATH set — preload injection detection (P2-02)"
    },

    "python_packages_diff": {
      "query": "SELECT name, version, path FROM python_packages;",
      "interval": 7200,
      "removed": false,
      "description": "Installed Python packages diff — supply-chain visibility (P2-02)"
    },

    "npm_packages_diff": {
      "query": "SELECT name, version, path FROM npm_packages;",
      "interval": 7200,
      "removed": false,
      "description": "Installed npm packages diff — supply-chain visibility (P2-02)"
    },

    "pip_packages_diff": {
      "query": "SELECT name, version, path FROM pip_packages;",
      "interval": 7200,
      "removed": false,
      "description": "Installed pip packages diff — supply-chain visibility (P2-02)"
    },

    "kernel_keys_diff": {
      "query": "SELECT * FROM kernel_keys;",
      "interval": 600,
      "removed": false,
      "description": "Kernel keyring entries (Kerberos/keychain credentials) (P2-02)"
    },

    "deb_packages_diff": {
      "query": "SELECT name, version, arch FROM deb_packages;",
      "interval": 3600,
      "removed": false,
      "description": "Installed deb packages diff — software inventory (P2-02)"
    },

    "acpi_tables_diff": {
      "query": "SELECT * FROM acpi_tables;",
      "interval": 86400,
      "removed": false,
      "description": "ACPI firmware tables — low-frequency tamper detection (P2-02)"
    },

    "sudoers_diff": {
      "query": "SELECT * FROM sudoers;",
      "interval": 1800,
      "removed": false,
      "description": "Sudoers rules diff — persistence / privilege escalation detection (P2-02)"
    },

    "suspicious_mmap": {
      "query": "SELECT pmm.pid, pmm.path, pmm.start, pmm.end, p.name AS process_name FROM process_memory_map pmm JOIN processes p ON p.pid = pmm.pid WHERE pmm.path != '' AND pmm.path NOT LIKE '/usr/%' AND pmm.path NOT LIKE '/lib/%' AND pmm.path NOT LIKE '/lib64/%' AND pmm.path NOT LIKE '[%';",
      "interval": 300,
      "removed": false,
      "description": "Non-standard shared objects mmap'd by processes — injection detection (P2-02)"
    }{% if osquery_profile | default('') == 'workstation' %},

    "chrome_extensions_diff": {
      "query": "SELECT uid, name, version, identifier, path FROM users CROSS JOIN chrome_extensions USING (uid);",
      "interval": 3600,
      "removed": false,
      "description": "Chrome extensions per user — workstation only (P2-02)"
    },

    "firefox_addons_diff": {
      "query": "SELECT uid, name, version, identifier, path FROM users CROSS JOIN firefox_addons USING (uid);",
      "interval": 3600,
      "removed": false,
      "description": "Firefox addons per user — workstation only (P2-02)"
    }{% endif %}{% if osquery_bpf_events_enabled | default(false) %},

    "docker_containers": {
      "query": "SELECT id, name, image, image_id, state, status, pid, (SELECT hostname FROM system_info) AS hostname FROM docker_containers WHERE state = 'running'",
      "interval": 30,
      "description": "Running container inventory diff (P2-01)"
    },

    "bpf_processes": {
      "query": "SELECT * FROM bpf_process_events;",
      "interval": {{ osquery_bpf_interval | default(10) }},
      "removed": false,
      "description": "Event-driven process creation/exit via eBPF (P2-01)"
    },

    "bpf_sockets": {
      "query": "SELECT * FROM bpf_socket_events;",
      "interval": {{ osquery_bpf_interval | default(10) }},
      "removed": false,
      "description": "Event-driven socket bind/connect/accept via eBPF (P2-01)"
    }{% endif %}

  },

  "decorators": {
    "load": [
      "SELECT hostname AS hostname FROM system_info",
      "SELECT version AS osquery_version FROM osquery_info"
    ]
  }
}
