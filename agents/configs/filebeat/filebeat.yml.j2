# /etc/filebeat/filebeat.yml
#
# Установка (Debian/Ubuntu):
#   apt install filebeat          # из elastic apt-репозитория
#   systemctl enable --now filebeat
#
# Права доступа к файлам:
#   /var/log/auth.log   → filebeat должен быть в группе adm:
#                         usermod -aG adm filebeat
#   /var/log/osquery/   → osquery пишет root:root, открыть через ACL:
#                         setfacl -m u:filebeat:r /var/log/osquery/osqueryd.results.log
#                         (повторять после logrotate — добавить в postrotate)
#
# Проверка:
#   filebeat test config -c /etc/filebeat/filebeat.yml
#   filebeat test output

filebeat.modules:

  # ── osquery — diff события из results log ────────────────────────────────────
  # Читает osqueryd.results.log (log_result_events=true в osquery.conf →
  # одна строка = одно изменение строки таблицы).
  # Snapshot log не читаем: осquery snapshot метрики выведены из схемы.
  - module: osquery
    result:
      enabled: true
      var.paths: ["/var/log/osquery/osqueryd.results.log"]

  # ── system/auth — SSH аутентификация ─────────────────────────────────────────
  # На Debian с rsyslog sshd пишет в /var/log/auth.log (стандарт).
  # Filebeat нормализует события в ECS: source.ip, user.name, event.outcome.
  - module: system
    auth:
      enabled: true
      var.paths: ["/var/log/auth.log*"]
    syslog:
      enabled: false

# Если на хосте нет rsyslog (pure journald) и /var/log/auth.log отсутствует —
# заменить system/auth выше на journald input:
#
# filebeat.modules:
#   - module: osquery
#     result:
#       enabled: true
#       var.paths: ["/var/log/osquery/osqueryd.results.log"]
#
# filebeat.inputs:
#   - type: journald
#     id: sshd-journald
#     seek: tail
#     units: [ssh.service]
#     processors:
#       - add_fields:
#           target: event
#           fields: {module: system, dataset: system.auth}

# ── Обогащение событий ────────────────────────────────────────────────────────
processors:
  - add_host_metadata:
      when.not.contains.tags: forwarded

# ── Выход → Logstash beats input ─────────────────────────────────────────────
output.logstash:
  hosts: ["{{ logstash_host }}:5044"]
  # tls:
  #   certificate_authorities: ["/etc/filebeat/opensearch-ca.pem"]

# ── Управление индексами/шаблонами ────────────────────────────────────────────
setup.template.enabled: false
setup.ilm.enabled: false

# ── Логирование самого filebeat ───────────────────────────────────────────────
logging.level: info
logging.to_files: true
logging.files:
  path: /var/log/filebeat
  name: filebeat
  keepfiles: 7
  permissions: 0640
