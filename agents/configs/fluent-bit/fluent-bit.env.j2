# /etc/default/fluent-bit — переменные окружения для сервиса fluent-bit
# Читается systemd unit как EnvironmentFile.
# После правки: systemctl restart fluent-bit

LOGSTASH_SECURITY_HOST={{ logstash_security_host }}
{% if base_stack | default([]) | length > 0 %}
LOGSTASH_COMMON_HOST={{ logstash_common_host }}
{% endif %}
FLUENT_CONFIG_VERSION={{ fluent_config_version }}
