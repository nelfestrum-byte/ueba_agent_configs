# /etc/fluent-bit/parsers.conf
# Сгенерирован Ansible из parsers.conf.j2

# ── Security: auditd ──────────────────────────────────────────────────────────

[PARSER]
    Name        auditd_line
    Format      regex
    Regex       ^type=(?<audit_type>[A-Z0-9_]+) msg=audit\((?<audit_epoch>[0-9]+)\.(?<audit_ms>[0-9]+):(?<serial>[0-9]+)\):\s*(?<msg>.*)$
    Time_Key    audit_epoch
    Time_Format %s
    Time_Keep   On
    Types       serial:integer audit_ms:integer

[PARSER]
    Name        auditd_user_msg
    Format      regex
    Regex       op=(?<op>[^ ]+) (?:grantors=(?<grantors>[^ ]+) )?acct="(?<acct>[^"]*)" exe="(?<exe>[^"]*)" hostname=(?<hostname>[^ ]+) addr=(?<addr>[^ ]+) terminal=(?<terminal>[^ ]+) res=(?<res>[^ ]+)

[PARSER]
    Name        auditd_kv
    Format      logfmt

[PARSER]
    Name        json
    Format      json
    Time_Key    unixTime
    Time_Format %s
    Time_Keep   On

[PARSER]
    Name        syslog_sshd
    Format      regex
    Regex       ^(?<timestamp>[A-Z][a-z]{2}\s+\d{1,2}\s+\d{2}:\d{2}:\d{2}) (?<hostname>\S+) (?<program>[^\[\s:]+)(?:\[(?<pid>\d+)\])?: (?<message>.*)$
    Time_Key    timestamp
    Time_Format %b %e %H:%M:%S
    Time_Keep   On

{% if client_stack | default([]) | length > 0 %}

# ── Client: общие ─────────────────────────────────────────────────────────────

[PARSER]
    Name         docker
    Format       json
    Time_Key     time
    Time_Format  %Y-%m-%dT%H:%M:%SZ
    Time_Strict  False
    Time_Keep    On

[PARSER]
    Name   logfmt
    Format logfmt

[PARSER]
    Name   nginx
    Format regex
    Regex  ^(?<remote>[^ ]*) (?<host>[^ ]*) (?<user>[^ ]*) \[(?<time>[^\]]*)\] "(?<method>\S+)(?: +(?<path>[^\"]*?)(?: +\S*)?)?" (?<code>[^ ]*) (?<size>[^ ]*)(?: "(?<referer>[^\"]*)" "(?<agent>[^\"]*)")?
    Time_Key    time
    Time_Format %d/%b/%Y:%H:%M:%S %z

[PARSER]
    Name        docker-daemon
    Format      regex
    Regex       time="(?<time>[^ ]*)" level=(?<level>[^ ]*) msg="(?<msg>[^ ].*)"
    Time_Key    time
    Time_Format %Y-%m-%dT%H:%M:%S.%L
    Time_Keep   On

{% endif %}
{% if 'freeipa' in client_stack | default([]) %}

# ── Client: FreeIPA ───────────────────────────────────────────────────────────

[MULTILINE_PARSER]
    Name            java_stacktrace
    Type            regex
    Flush_Timeout   1000
    Rule            "start_state" "/^\[/" "cont"
    Rule            "cont" "/^\s+at.*/" "cont"

[PARSER]
    Name            ipa_kdc
    Format          regex
    Regex           ^(?<timestamp>[A-Z][a-z]{2}\s+\d+\s+\d+:\d+:\d+)\s+(?<host>\S+)\s+krb5kdc\[(?<pid>\d+)\].*?(?<event_desc>AS_REQ|TGS_REQ|PREAUTH_FAILED).*?:\s+(?<message>.*)$

[PARSER]
    Name            dirsrv_access
    Format          regex
    Regex           ^\[(?<timestamp>[^\]]+)\]\s+conn=(?<ldap_connection_id>\d+)\s+op=(?<ldap_operation_id>\d+)\s+(?<message>.*)$

[PARSER]
    Name            dirsrv_error
    Format          regex
    Regex           ^\[(?<timestamp>[^\]]+)\]\s+(?<message>.*)$

[PARSER]
    Name            dirsrv_audit
    Format          regex
    Regex           ^time:\s+(?<timestamp>.+?)\s+dn:\s+(?<ldap_dn>.+?)\s+(?<message>.*)$

[PARSER]
    Name            apache_access
    Format          regex
    Regex           ^(?<source_ip>\S+)\s+\S+\s+(?<user_name>\S+)\s+\[(?<timestamp>[^\]]+)\]\s+"(?<http_request_method>\S+)\s+(?<url_path>\S+)\s+\S+"\s+(?<http_response_status_code>\d+)\s+(?<http_response_body_bytes>\S+).*$

[PARSER]
    Name            apache_error
    Format          regex
    Regex           ^\[(?<timestamp>[^\]]+)\]\s+\[(?<apache_module>[^\]]+)\]\s+\[(?<log_level>[^\]]+)\].*?(?<message>.*)$

[PARSER]
    Name            dogtag
    Format          regex
    Regex           ^\[(?<timestamp>[^\]]+)\]\s+\[(?<thread>[^\]]+)\]\s+\[(?<log_level>[^\]]+)\]\s+(?<message>.*)$

[PARSER]
    Name            bind_dns
    Format          regex
    Regex           ^(?<timestamp>\d+-[A-Za-z]{3}-\d+\s+\d+:\d+:\d+\.\d+)\s+(?<category>\S+):\s+(?<message>.*)$

[PARSER]
    Name            sssd
    Format          regex
    Regex           ^\((?<timestamp>[^)]+)\)\s+\[(?<component>[^\]]+)\]\s+\[(?<log_level>[^\]]+)\]\s+(?<message>.*)$

{% endif %}
