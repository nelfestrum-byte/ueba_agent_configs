## /etc/audit/rules.d/ueba.rules
## Правила auditd для UEBA (production, bare-metal Debian)
##
## Установка:
##   1. Скопировать файл в /etc/audit/rules.d/ueba.rules
##      (рекомендуется единственный файл правил, чтобы избежать конфликтов с
##       поставляемыми augenrules при `apt install auditd`).
##   2. augenrules --load          # сборка /etc/audit/audit.rules + загрузка
##   3. systemctl enable --now auditd
##   4. auditctl -s                # проверить enabled=1, backlog, lost
##
## Доступ к /var/log/audit/audit.log для fluent-bit:
##   - В Debian каталог /var/log/audit принадлежит root:root, права 0750.
##   - Простой вариант: `chgrp adm /var/log/audit /var/log/audit/audit.log` и
##     закрепить через `log_group = adm` в /etc/audit/auditd.conf
##     (после смены — `systemctl restart auditd`).
##   - Затем добавить пользователя fluent-bit в группу adm:
##     `usermod -aG adm fluent-bit`.

# Очистить ранее загруженные правила (на старте — обязательная директива)
-D

# ── Системные параметры ──────────────────────────────────────────────────────
# Размер буфера ядра (по событию ~1KB; 16384 даёт ~16 МБ, держит всплески execve)
-b 16384

# Лимит частоты событий в секунду (0=без лимита; 1000 защищает от DoS логами)
-r 1000

# Поведение при переполнении: 1=printk в dmesg (sane default; 2=panic — слишком жёстко)
-f 1

# Максимальное время ожидания при backlog full (мс) — даёт ядру шанс не терять события
--backlog_wait_time 60000

# ── Запуск процессов (execve) ────────────────────────────────────────────────
-a always,exit -F arch=b64 -S execve -k process_start
-a always,exit -F arch=b32 -S execve -k process_start

# ── Аутентификация и PAM ─────────────────────────────────────────────────────
-w /etc/pam.d/        -p wa -k pam_changes
-w /etc/security/     -p wa -k security_changes
-w /etc/nsswitch.conf -p wa -k nsswitch_changes
-w /etc/ssh/sshd_config -p wa -k sshd_config

# ── Изменения пользователей и групп ──────────────────────────────────────────
-w /etc/passwd   -p wa -k user_changes
-w /etc/shadow   -p wa -k user_changes
-w /etc/group    -p wa -k user_changes
-w /etc/gshadow  -p wa -k user_changes
-w /etc/sudoers  -p wa -k sudo_changes
-w /etc/sudoers.d/ -p wa -k sudo_changes

# ── SSH ключи ────────────────────────────────────────────────────────────────
-a always,exit -F arch=b64 -S open,openat -F dir=/root/.ssh -k ssh_keys
# -F name=authorized_keys не поддерживается в auditd < 3.0 (Debian Buster).
# Для auditd >= 3.0 можно добавить: -a always,exit -F arch=b64 -S open,openat -F dir=/home -F name=authorized_keys -k ssh_keys

# ── Cron ─────────────────────────────────────────────────────────────────────
-w /etc/cron.d/       -p wa -k cron_changes
-w /etc/cron.daily/   -p wa -k cron_changes
-w /etc/cron.hourly/  -p wa -k cron_changes
-w /etc/cron.weekly/  -p wa -k cron_changes
-w /etc/cron.monthly/ -p wa -k cron_changes
-w /etc/crontab       -p wa -k cron_changes
-w /var/spool/cron/   -p wa -k cron_changes

# ── systemd unit-файлы (post-exploitation персистентность) ───────────────────
-w /etc/systemd/system/ -p wa -k systemd_changes
-w /lib/systemd/system/ -p wa -k systemd_changes
-w /usr/lib/systemd/system/ -p wa -k systemd_changes

# ── Сетевые системные вызовы ─────────────────────────────────────────────────
-a always,exit -F arch=b64 -S socket -F a0=2  -k socket_create
-a always,exit -F arch=b64 -S socket -F a0=10 -k socket_create
-a always,exit -F arch=b64 -S bind   -k socket_bind
-a always,exit -F arch=b64 -S listen -k socket_listen
-a always,exit -F arch=b64 -S connect -k socket_connect

# ── Модули ядра ──────────────────────────────────────────────────────────────
-a always,exit -F arch=b64 -S init_module,finit_module -k module_load
-a always,exit -F arch=b64 -S delete_module -k module_unload
-w /etc/modprobe.conf  -p wa -k module_changes
-w /etc/modprobe.d/    -p wa -k module_changes

# ── Подозрительные пути выполнения ───────────────────────────────────────────
-a always,exit -F arch=b64 -S execve -F dir=/tmp     -k suspicious_exec
-a always,exit -F arch=b64 -S execve -F dir=/dev/shm -k suspicious_exec
-a always,exit -F arch=b64 -S execve -F dir=/var/tmp -k suspicious_exec

# ── Повышение привилегий ─────────────────────────────────────────────────────
-a always,exit -F arch=b64 -S setuid    -k privilege_change
-a always,exit -F arch=b64 -S setgid    -k privilege_change
-a always,exit -F arch=b64 -S setresuid -k privilege_change
-a always,exit -F arch=b64 -S setresgid -k privilege_change

# ── Изменение времени системы (anti-tampering) ───────────────────────────────
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k time_change
-w /etc/localtime -p wa -k time_change

# ── Иммутабельный режим (раскомментировать после стабилизации правил) ────────
## После -e 2 правила нельзя изменить до перезагрузки. Это рекомендуется в проде,
## но имеет смысл включать только когда правила выше точно устаканились.
# -e 2
