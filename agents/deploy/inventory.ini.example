# Скопировать в inventory.ini и заполнить реальными хостами.
#
# Структура групп:
#   ueba_agents          — все хосты с UEBA-агентами (родитель)
#   ├── pure_ueba        — только auditd + osquery ECS (base_stack: [])
#   ├── bpf_hosts        — pure_ueba + osquery BPF backend (глубокий UEBA, ядро ≥5.10)
#   ├── workstations     — pure_ueba + workstation osquery-профиль
#   ├── freeipa_hosts    — + клиентский pipeline: freeipa/docker
#   ├── keycloak_hosts   — + клиентский pipeline: keycloak container logs
#   ├── docker_log_hosts — + клиентский pipeline: docker_events (обычные логи)
#   ├── spo_hosts        — + клиентский pipeline: docker_events/waf
#   └── ssz_hosts        — + клиентский pipeline: docker_events/suricata/bird

[ueba_agents:children]
pure_ueba
bpf_hosts
workstations
freeipa_hosts
keycloak_hosts
docker_log_hosts
spo_hosts
ssz_hosts

# ── Pure UEBA (только security pipeline) ─────────────────────────────────────
[pure_ueba]
# server01.example.com  ansible_host=10.0.0.11
# server02.example.com  ansible_host=10.0.0.12

# ── BPF-хосты: osquery BPF backend, глубокий UEBA-мониторинг (P2-01) ─────────
# Требования: ядро ≥5.10, /sys/kernel/btf/vmlinux, osquery ≥4.6
# group_vars/bpf_hosts.yml: osquery_bpf_events_enabled=true
[bpf_hosts]
# docker-node-1.example.com  ansible_host=10.0.0.21
# docker-node-2.example.com  ansible_host=10.0.0.22

# ── Workstations: осquery workstation-профиль ─────────────────────────────────
# group_vars/workstations.yml: osquery_profile=workstation
[workstations]
# ws-alice.example.com  ansible_host=10.0.0.31

# ── FreeIPA-хосты: base_stack=[freeipa, docker_events, suricata, waf] ──────
# group_vars/freeipa_hosts.yml задаёт base_stack
[freeipa_hosts]
# freeipa.example.com  ansible_host=10.0.0.51

# ── Keycloak-хосты: base_stack=[keycloak] ──────────────────────────────────
# group_vars/keycloak_hosts.yml задаёт base_stack
[keycloak_hosts]
# keycloak.example.com  ansible_host=10.0.0.52

# ── Docker log-хосты: обычные логи docker_events → общий pipeline
# group_vars/docker_log_hosts.yml задаёт base_stack
[docker_log_hosts]
# docker-events-1.example.com  ansible_host=10.0.0.53

# ── СПО-хосты: docker_events + waf ──────────────────────────────────────────
# group_vars/spo_hosts.yml задаёт base_stack
[spo_hosts]
# spo-1.example.com  ansible_host=10.0.0.54

# ── ССЗ-хосты: docker_events + suricata + bird ──────────────────────────────
# group_vars/ssz_hosts.yml задаёт base_stack
[ssz_hosts]
# ssz-1.example.com  ansible_host=10.0.0.55

[ueba_agents:vars]
ansible_user=deploy
ansible_become=true
ansible_python_interpreter=/usr/bin/python3
