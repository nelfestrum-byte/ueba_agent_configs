# Скопировать в inventory.ini и заполнить реальными хостами.
#
# Структура групп:
#   ueba_agents          — все хосты с UEBA-агентами (родитель)
#   ├── pure_ueba        — только auditd + osquery ECS (base_stack: [])
#   ├── docker_hosts     — pure_ueba + osquery BPF backend
#   ├── workstations     — pure_ueba + workstation osquery-профиль
#   ├── freeipa_hosts    — + базовый pipeline: freeipa/docker/suricata/waf
#   ├── keycloak_hosts   — + базовый pipeline: keycloak container logs
#   └── docker_event_hosts — + базовый pipeline: docker_events/suricata/waf

[ueba_agents:children]
pure_ueba
docker_hosts
workstations
freeipa_hosts
keycloak_hosts
docker_event_hosts

# ── Pure UEBA (только security pipeline) ─────────────────────────────────────
[pure_ueba]
# server01.example.com  ansible_host=10.0.0.11
# server02.example.com  ansible_host=10.0.0.12

# ── Docker-хосты: BPF backend (P2-01) ────────────────────────────────────────
# Требования: ядро ≥5.10, /sys/kernel/btf/vmlinux, osquery ≥4.6
# group_vars/docker_hosts.yml: osquery_bpf_events_enabled=true
[docker_hosts]
# docker-node-1.example.com  ansible_host=10.0.0.21
# docker-node-2.example.com  ansible_host=10.0.0.22

# ── Workstations: осquery workstation-профиль ─────────────────────────────────
# group_vars/workstations.yml: osquery_profile=workstation
[workstations]
# ws-alice.example.com  ansible_host=10.0.0.31

# ── FreeIPA-хосты: base_stack=[freeipa, docker_events, suricata, waf] ──────
# group_vars/freeipa_hosts.yml задаёт base_stack
[freeipa_hosts]
# freeipa.example.com  ansible_host=10.0.0.51

# ── Keycloak-хосты: base_stack=[keycloak] ──────────────────────────────────
# group_vars/keycloak_hosts.yml задаёт base_stack
[keycloak_hosts]
# keycloak.example.com  ansible_host=10.0.0.52

# ── Docker event-хосты: base_stack=[docker_events, suricata, waf] ──────────
# group_vars/docker_event_hosts.yml задаёт base_stack
[docker_event_hosts]
# docker-events-1.example.com  ansible_host=10.0.0.53

[ueba_agents:vars]
ansible_user=deploy
ansible_become=true
ansible_python_interpreter=/usr/bin/python3
