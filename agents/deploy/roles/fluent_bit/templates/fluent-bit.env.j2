# /etc/default/fluent-bit — переменные окружения для сервиса fluent-bit
# Управляется Ansible (роль fluent_bit). Не редактировать вручную.
# Читается systemd unit как EnvironmentFile= и доступен в conf.d/*.conf как ${VAR}.

LOGSTASH_SECURITY_HOST={{ logstash_security_host }}
LOGSTASH_SECURITY_AUDIT_PORT={{ logstash_security_audit_port | default(5045) }}
LOGSTASH_SECURITY_OSQUERY_PORT={{ logstash_security_osquery_port | default(5047) }}
LOGSTASH_COMMON_HOST={{ logstash_common_host | default('') }}
LOGSTASH_COMMON_PORT={{ logstash_common_port | default(5044) }}
FLUENT_FORWARD_PORT={{ fluent_forward_port | default(24224) }}
DOCKER_SOCKET={{ docker_socket | default('/var/run/docker.sock') }}
FREEIPA_LOG_BASE={{ freeipa_log_base | default('/var/lib/ipa-data/var/log') }}
SURICATA_LOG_PATH={{ suricata_log_path | default('/opt/suricata/logs/eve.json') }}
WAF_LOG_PATH={{ waf_log_path | default('/opt/nginx/logs/modsecurity.log') }}
FLUENT_CONFIG_VERSION={{ fluent_config_version }}
