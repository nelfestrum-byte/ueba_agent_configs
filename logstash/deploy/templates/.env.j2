OPENSEARCH_URL={{ opensearch_url }}
OPENSEARCH_USER={{ opensearch_user }}
OPENSEARCH_PASSWORD={{ opensearch_password }}
OPENSEARCH_SSL={{ opensearch_ssl | default('true') }}
OPENSEARCH_SSL_VERIFY={{ opensearch_ssl_verify | default('true') }}
OPENSEARCH_CA_CERT=/usr/share/logstash/config/certs/opensearch-ca.pem
LOGSTASH_BIND_ADDR={{ logstash_bind_addr | default('0.0.0.0') }}
