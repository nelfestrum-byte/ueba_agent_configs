OPENSEARCH_URL={{ opensearch_url }}
OPENSEARCH_USER={{ opensearch_user | default('') }}
OPENSEARCH_PASSWORD={{ opensearch_password | default('') }}
OPENSEARCH_SSL={{ opensearch_ssl | default('true') }}
OPENSEARCH_SSL_VERIFY={{ opensearch_ssl_verify | default('true') }}
OPENSEARCH_CA_CERT={% if opensearch_ssl | default('false') | bool %}/usr/share/logstash/config/certs/opensearch-ca.pem{% endif %}

LOGSTASH_BIND_ADDR={{ logstash_bind_addr | default('0.0.0.0') }}
